# Ajustar usuario, contraseña y host según su PostgreSQL local en Windows
DATABASE_URL=postgresql+psycopg://geochange:geochange@localhost:5432/geochange
APP_ENV=local
CORS_ORIGINS=http://localhost:5173
# Raíz para resolver asset_path relativos (relativo al cwd del backend, o absoluto)
DATA_ROOT=../data
# Optional. Enables MapTiler Terrain RGB in GET /api/v1/map-providers/config.
# The TileJSON URL returned to the frontend includes this key (no tile proxy yet).
MAPTILER_API_KEY=
